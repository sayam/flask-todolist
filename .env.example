# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก gitignore ไว้)
#
# SECRET_KEY จำเป็นต้องมี ไม่ตั้งแล้วแอปจะไม่ start
# ใช้เซ็นทั้ง session cookie และ CSRF token — ใครรู้คีย์นี้ปลอมได้ทั้งสองอย่าง
# สร้างคีย์ใหม่:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# ไม่ตั้งก็ได้ default เป็น sqlite ใน instance/todolist.db
# DATABASE_URL=sqlite:///todolist.db

# กุญแจที่ใช้ปิดบังค่าของ PII/เนื้อหาผู้ใช้ใน audit trail (HMAC)
# ไม่ตั้งก็ได้ — จะแยกสายมาจาก SECRET_KEY ให้เอง
# แต่ถ้าตั้งแยกไว้ เปลี่ยน SECRET_KEY ทีหลังแล้วยังเทียบค่าเก่าใน audit ได้อยู่
# ทำคีย์นี้หายแล้วเทียบค่าเก่าไม่ได้อีก (ตัว hash chain ยังตรวจได้ตามปกติ)
# AUDIT_HMAC_KEY=

# --- อายุของ session (Phase 4 — ค่าเริ่มต้นพอสำหรับงานทั่วไป) ---
# ไม่มีความเคลื่อนไหวนานเท่านี้ถือว่าจบ / เพดานที่หมดอายุแม้ใช้งานอยู่ตลอด
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12
# เวลาที่ให้กรอกรหัสขั้นที่สองหลังใส่รหัสผ่านถูกแล้ว
# MFA_PENDING_SECONDS=300

# --- โควตาหน้า login (สองมิติ: ต่อ IP และต่อชื่อผู้ใช้) ---
# LOGIN_RATE_LIMIT=5 per minute; 20 per hour
# LOGIN_USERNAME_RATE_LIMIT=10 per 5 minutes; 60 per hour
# ต้องเปลี่ยนเป็น redis:// ถ้ารันหลาย worker ไม่งั้นเพดานจริงเป็น N เท่า
# RATELIMIT_STORAGE_URI=memory://

# --- ตัวเลือกของ plugin (Phase 4.5 — ADR 0025) ---
# ความสามารถที่มีส่วนเสริมให้เลือกหลายตัว ต้องระบุว่าจะใช้ตัวไหน ไม่งั้นปิดทั้งหมด
# (fail closed — การเดาให้แปลว่าวางไดเรกทอรีเพิ่มแล้วพฤติกรรมเปลี่ยนโดยไม่มีใครสั่ง)
# PLUGIN_PICKS=auth/totp#qr=qr-segno
#
# สวิตช์ปิดจุด plug ทันทีโดยไม่ต้องแก้โค้ดและไม่ต้องรอ deploy (สำหรับวันที่ CVE ออก)
# ใช้คีย์เดียวกับที่ `flask plugin-list` แสดง คั่นด้วยจุลภาค
# ปิดแล้วเหมือนไม่เคยวางไดเรกทอรีลงไป — แต่ **ข้อมูลของ plugin ยังอยู่ครบ**
# (ลบข้อมูลต้องสั่ง `flask plugin-uninstall` เอง ซึ่งยังทำได้แม้ปิดสวิตช์ไว้)
# ปิด plugin ของ core ไม่ได้ ใส่ไปแล้วแอปจะไม่ start
# DISABLED_PLUGINS=auth/totp#qr-segno,themes/ocean
